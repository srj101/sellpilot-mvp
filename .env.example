# =============================================================================
# SellPilot environment
#
# Local and production run the SAME stack (`docker compose up -d --build`), so
# this file is the ONLY thing that differs between them: the domain in APP_URL,
# which AWS credentials, which Neon branch. docker-compose.yml overrides nothing
# but container topology (REDIS_HOST, PORT, per-service AWS keys).
#
# Every variable below is declared in one of:
#   packages/env/src/index.ts   shared: api, db, messaging, ai-agent, queue, worker
#   apps/nextjs/src/env.ts      web-only  (+ NEXT_PUBLIC_* client vars)
#   apps/worker/src/env.ts      worker-only
#   packages/auth/env.ts        better-auth
#
# REQUIRED = no default; the app refuses to boot without it.
# =============================================================================

# --- Database ----------------------------------------------------------------
# REQUIRED. Neon. The @vercel/postgres driver speaks Neon's WebSocket protocol,
# not raw TCP, so this cannot point at a plain postgres container.
POSTGRES_URL="postgresql://user:password@your-project.neon.tech/neondb?sslmode=require"

# --- Public origin -----------------------------------------------------------
# Default http://localhost:3000. MUST be the real public origin in production:
# it builds the /pay/{token} checkout links the AI agent sends customers and the
# SSLCommerz success/fail/ipn callback URLs. Left at localhost, customers receive
# payment links that resolve to nothing.
APP_URL="http://localhost:3000"

# --- Authentication ----------------------------------------------------------
AUTH_SECRET="generate-with-openssl-rand-base64-32"   # REQUIRED in production
BETTER_AUTH_URL="http://localhost:3000"
VERCEL_PROJECT_PRODUCTION_URL="https://your-domain.com"

GOOGLE_CLIENT_ID="your-google-client-id"             # REQUIRED
GOOGLE_CLIENT_SECRET="your-google-client-secret"     # REQUIRED

# --- Meta / Facebook ---------------------------------------------------------
# Two separate Facebook Apps:
#  - FACEBOOK_CLIENT_ID/SECRET: the "Sign in with Facebook" app (better-auth only)
#  - FACEBOOK_APP_ID/SECRET:    the messaging app — Graph API calls for the
#    Page/Instagram/WhatsApp integration AND webhook signature verification
#    (X-Hub-Signature-256 is always signed with this app's secret)
FACEBOOK_CLIENT_ID="your-facebook-login-app-id"          # REQUIRED
FACEBOOK_CLIENT_SECRET="your-facebook-login-app-secret"  # REQUIRED

FACEBOOK_APP_ID="your-facebook-messaging-app-id"         # REQUIRED
FACEBOOK_APP_SECRET="your-facebook-messaging-app-secret" # REQUIRED
FACEBOOK_GRAPH_VERSION="v25.0"

META_WEBHOOK_VERIFY_TOKEN="your-webhook-verify-token"    # REQUIRED
META_CHANNEL_REDIRECT_URI="http://localhost:3000/api/meta/callback"

# Inlined into the browser bundle at BUILD time. Changing one requires a rebuild
# (`docker compose up -d --build`), not just a restart — docker-compose.yml
# passes these as build args.
NEXT_PUBLIC_FACEBOOK_APP_ID="your-facebook-app-id"
NEXT_PUBLIC_FACEBOOK_CONFIG_ID="your-facebook-login-config-id"
NEXT_PUBLIC_WHATSAPP_CONFIG_ID="your-whatsapp-config-id"
NEXT_PUBLIC_WHATSAPP_REDIRECT_URI="http://localhost:3000/dashboard/integrations"

# --- AI agent ----------------------------------------------------------------
OPENAI_API_KEY="your-openai-or-compatible-key"
OPENAI_BASE_URL=""                 # set for OpenRouter/Azure/self-hosted
OPENAI_MODEL="gpt-4o-mini"

# Visual product search. NVIDIA's NeMo Retriever VL embed model — a genuinely
# multimodal embedder, so a customer's photo is compared to catalog photos in real
# visual space rather than via text descriptions. OpenAI has no equivalent: its
# embedding models are text-only. Free-tier hosted, 2048 dimensions, which must
# match the vector(...) width of product_image_embedding.embedding.
#
# Optional — without the key, image indexing and image search no-op rather than
# erroring (see packages/api/src/lib/embeddings.ts and vector-search.ts).
NVIDIA_API_KEY=""
NVIDIA_EMBEDDINGS_URL="https://integrate.api.nvidia.com/v1/embeddings"
NVIDIA_EMBED_MODEL="nvidia/llama-nemotron-embed-vl-1b-v2"

# Voice transcription (Pro plan only). OpenAI's hosted API — same service in
# local and production. Any OpenAI-compatible /v1/audio/transcriptions endpoint
# works; switching provider is a URL change, no code change.
TRANSCRIPTION_BASE_URL="https://api.openai.com/v1/audio/transcriptions"
# Leave empty: it falls back to OPENAI_API_KEY, which is the right credential for
# the default endpoint. Set it only if transcription uses a different provider
# from the chat model.
TRANSCRIPTION_API_KEY=""
# "whisper-1" is the broadly available default. "gpt-4o-mini-transcribe" is
# cheaper and generally stronger on code-switched Bangla/Banglish speech — same
# endpoint and response shape, so it is a drop-in swap worth testing.
TRANSCRIPTION_MODEL="whisper-1"

# --- Worker tuning -----------------------------------------------------------
RATE_LIMIT_PER_HOUR="200"
AI_TIMEOUT_MS="30000"
AI_FALLBACK_MESSAGE="Thanks for your message! We'll get back to you shortly."
# Unset = no health server at all. docker-compose.yml sets it to 3001.
WORKER_HEALTH_PORT="3001"

# --- Queue -------------------------------------------------------------------
# "memory" | "redis". Same value in local and production.
#
# "memory" cannot work here at all: web and worker are separate containers, so
# in-memory jobs never reach the worker, silently.
#
# "redis" is what the code was built for — the only provider that honours job
# priority, delays longer than 15 minutes (the self-rescheduling billing sweeps
# ask for 24h), and the cross-process thread-cancel broadcast that stops two
# worker replicas both replying to the same customer.
#
# An AWS SQS provider existed and was removed once Redis proved the better fit.
# docs/SQS_SETUP.md keeps the runbook if it is ever needed again.
QUEUE_PROVIDER="redis"


# Single source of truth for every Redis client in the repo. Still required even
# on SQS: packages/api/src/lib/queue.ts runs the product-images indexing queue on
# BullMQ directly, and the cross-process thread-cancel broadcast is Redis pub/sub.
# docker-compose.yml overrides REDIS_HOST to the "redis" service name. This
# value only applies if you run a process outside the stack.
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_DB="0"
REDIS_TLS="false"

# --- AWS ---------------------------------------------------------------------
AWS_REGION="ap-southeast-1"
AWS_S3_BUCKET="sellpilot"
AWS_SES_FROM_EMAIL="no-reply@sellpilot-mvp.online"

# One shared credential across the SES, S3 and SQS clients. In Docker these are
# replaced per service by SELLPILOT_WEB_* / SELLPILOT_WORKER_* below.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Docker only. compose maps these onto AWS_ACCESS_KEY_ID per service so the web
# app can produce to SQS but not consume, and the worker can consume. Ignored by
# application code — they exist purely for compose interpolation.
SELLPILOT_WEB_ACCESS_KEY_ID=""
SELLPILOT_WEB_SECRET_ACCESS_KEY=""
SELLPILOT_WORKER_ACCESS_KEY_ID=""
SELLPILOT_WORKER_SECRET_ACCESS_KEY=""

# --- Payments ----------------------------------------------------------------
# SellPilot's OWN platform gateway account — SaaS subscription billing only,
# never a merchant's customer checkout (those credentials live per-business on
# businessProfile). A superadmin-managed platformSettings row takes precedence;
# these are the fallback. Sandbox stays an env var so no UI can flip it in prod.
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_IS_SANDBOX="true"

# --- Security ----------------------------------------------------------------
# AES-256 key source for store-connection credentials at rest (SHA-256 hashed to
# 32 bytes). MUST be set or connecting a Shopify/WooCommerce store fails closed.
# Generate with: openssl rand -base64 32
STORE_CONNECTION_ENCRYPTION_KEY="replace-me-with-a-long-random-string"

# Leave empty and /api/cron/sync-images is PUBLICLY CALLABLE — the gate is
# `if (env.CRON_SECRET && ...)`. Anyone could trigger a full re-index of every
# product image. Set it, then have callers send: Authorization: Bearer <value>
CRON_SECRET=""

# Staged RBAC rollout. While false, permission denials are logged with full
# context and allowed through, so legacy members who would be locked out surface
# in the logs first. Flip to "true" to actually enforce.
RBAC_ENFORCE="false"

# --- Misc --------------------------------------------------------------------
SALES_EMAIL="sales@sellpilot-mvp.online"

# Read directly by the LangSmith SDK, not through any env schema. Optional.
LANGSMITH_TRACING="false"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="sellpilot"
