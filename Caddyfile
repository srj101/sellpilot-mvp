# TLS termination for the stack. Caddy obtains and renews Let's Encrypt
# certificates automatically once APP_DOMAIN's DNS points at this machine —
# which is required, because Meta refuses to deliver webhooks over plain HTTP.
#
# APP_DOMAIN comes from .env. Set it to your real hostname on the VPS; leave it
# as "localhost" locally and Caddy issues its own internal certificate instead of
# hammering Let's Encrypt for a domain that doesn't resolve here.
{$APP_DOMAIN} {
	encode zstd gzip

	# Server-Sent Events (the inbox and notification streams) must not be
	# buffered or the dashboard stops updating until the connection closes.
	@sse path /api/inbox/stream /api/notifications/stream
	reverse_proxy @sse web:3000 {
		flush_interval -1
	}

	reverse_proxy web:3000
}
