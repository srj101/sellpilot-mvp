{
  "name": "@acme/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./meta": {
      "types": "./dist/lib/meta.d.ts",
      "default": "./src/lib/meta.ts"
    },
    "./plans": {
      "types": "./dist/lib/plans.d.ts",
      "default": "./src/lib/plans.ts"
    },
    "./plan-limits": {
      "types": "./dist/lib/plan-limits.d.ts",
      "default": "./src/lib/plan-limits.ts"
    },
    "./meta-inbox": {
      "types": "./dist/lib/meta-inbox.d.ts",
      "default": "./src/lib/meta-inbox.ts"
    },
    "./resolve-contact-names": {
      "types": "./dist/lib/resolve-contact-names.d.ts",
      "default": "./src/lib/resolve-contact-names.ts"
    },
    "./vector-search": {
      "types": "./dist/lib/vector-search.d.ts",
      "default": "./src/lib/vector-search.ts"
    },
    "./queue": {
      "types": "./dist/lib/queue.d.ts",
      "default": "./src/lib/queue.ts"
    },
    "./notify-queue": {
      "types": "./dist/lib/notify-queue.d.ts",
      "default": "./src/lib/notify-queue.ts"
    },
    "./s3": {
      "types": "./dist/lib/s3.d.ts",
      "default": "./src/lib/s3.ts"
    },
    "./sslcommerz": {
      "types": "./dist/lib/sslcommerz.d.ts",
      "default": "./src/lib/sslcommerz.ts"
    },
    "./media-storage": {
      "types": "./dist/lib/media-storage.d.ts",
      "default": "./src/lib/media-storage.ts"
    },
    "./image-compress": {
      "types": "./dist/lib/image-compress.d.ts",
      "default": "./src/lib/image-compress.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "with-env": "dotenv -e ../../.env --",
    "search:backfill": "pnpm with-env tsx src/scripts/backfill-search-text.ts",
    "media:backfill": "pnpm with-env tsx src/scripts/backfill-conversation-media.ts"
  },
  "dependencies": {
    "@acme/auth": "workspace:*",
    "@acme/db": "workspace:*",
    "@acme/env": "workspace:*",
    "@acme/queue": "workspace:*",
    "@acme/validators": "workspace:*",
    "@aws-sdk/client-s3": "^3.1094.0",
    "@aws-sdk/s3-request-presigner": "^3.1094.0",
    "@trpc/server": "catalog:",
    "bullmq": "^5.79.3",
    "superjson": "2.2.3",
    "zod": "catalog:",
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "@acme/eslint-config": "workspace:*",
    "@acme/prettier-config": "workspace:*",
    "@acme/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "tsx": "^4.7.0",
    "dotenv-cli": "^10.0.0"
  },
  "prettier": "@acme/prettier-config"
}
